# ============================================================
# .dockerignore — những gì KHÔNG đưa vào Docker build context (tiêu chí 3)
# ============================================================

# Secrets
.env
.env.*
!.env.example

# Python cache
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/

# Virtualenv
venv/
.venv/
env/

# Git, IDE, OS
.git/
.gitignore
.vscode/
.idea/
.DS_Store

# Không cần khi chạy agent
benchmark-observability/
check_production_ready.py
*.md
docker-compose.yml
railway.toml
render.yaml
